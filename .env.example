# Copie este arquivo para ".env" (cp .env.example .env) e ajuste os valores.
# O ".env" NÃO vai para o GitHub. Este ".env.example" vai, por isso não coloque segredos reais aqui.

# --- Aplicação ---
AMBIENTE=desenvolvimento

# --- Banco de dados (SQLite). Para trocar por PostgreSQL, mude só esta URL ---
DATABASE_URL=sqlite:///./data/hortas.db

# --- Segurança (JWT) ---
# Gere uma chave com: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=troque-esta-chave
JWT_ALGORITHM=HS256
JWT_EXPIRA_MINUTOS=60

# --- Conta do Administrador Hoot (criada na primeira execução) ---
ADMIN_HOOT_NOME=Administrador Hoot
ADMIN_HOOT_EMAIL=admin@exemplo.com
ADMIN_HOOT_SENHA=troque-esta-senha

# --- Front-end (CORS): origens permitidas, separadas por vírgula ---
# Ajuste para a porta real do front quando a equipe definir.
CORS_ORIGENS=http://localhost:5173

# --- Valores dos requisitos (estimativas da equipe, podem mudar sem mexer no código) ---
TEMPO_RESPOSTA_MAX_SEGUNDOS=3
ALERTA_ANTECEDENCIA_DIAS=1
EMAIL_REENVIO_INTERVALO_MIN=15
EMAIL_REENVIO_MAX_TENTATIVAS=3

# --- E-mail: "console" escreve no terminal; "smtp" envia de verdade ---
EMAIL_MODO=console
EMAIL_REMETENTE=hortas@exemplo.com
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
